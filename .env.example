DB_HOST=localhost
DB_PORT=5432
DB_NAME=agentops
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-password
DB_DDL_AUTO=update

# Optional ports published by Docker Compose (database uses 5433 to avoid local PostgreSQL).
BACKEND_PORT=8080
POSTGRES_PORT=5433

# Base64-encoded cryptographically random key (at least 32 bytes); see README.
JWT_SECRET=replace-with-generated-base64-key
JWT_ISSUER=agentops
JWT_EXPIRATION_SECONDS=3600
REFRESH_TOKEN_EXPIRATION_SECONDS=604800
# Set true when serving the API over HTTPS.
AUTH_COOKIE_SECURE=false

# Set a real provider key locally; chat returns 503 while this is blank.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_OUTPUT_TOKENS=2048
AGENT_MAX_TOOL_ROUNDS=4
AGENT_MAX_TOOL_CALLS=8
AGENT_CONTEXT_MESSAGES=40
